{
    "version": 8,
    "configurePresets": [
        {
            "name": "clang-Ninja",
            "displayName": "alienware Clang 19.1.0 x86_64-pc-windows-msvc - Ninja",
            "description": "正在使用编译器: C = C:\\Program Files\\LLVM\\bin\\clang.exe, CXX = C:\\Program Files\\LLVM\\bin\\clang++.exe",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
                "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "vs2019",
            "displayName": "Visual Studio Community 2019 Release - amd64",
            "description": "将编译器用于 Visual Studio 16 2019 (x64 体系结构)",
            "generator": "Visual Studio 16 2019",
            "toolset": "host=x64",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "ci-debug",
            "displayName": "CI Windows Debug (MSVC + Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/ci-debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/ci-debug",
                "AEROVISTA_BUILD_VSG_EXAMPLES": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ci-release",
            "displayName": "CI Windows Release (MSVC + Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/ci-release",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/ci-release",
                "AEROVISTA_BUILD_VSG_EXAMPLES": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "ci-clang",
            "displayName": "CI Windows Clang Debug (Clang + Ninja)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/ci-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/ci-clang",
                "AEROVISTA_BUILD_VSG_EXAMPLES": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2019-debug",
            "displayName": "Visual Studio Community 2019 Release - amd64 - Debug",
            "configurePreset": "vs2019",
            "configuration": "Debug"
        },
        {
            "name": "ci-debug",
            "configurePreset": "ci-debug"
        },
        {
            "name": "ci-release",
            "configurePreset": "ci-release"
        },
        {
            "name": "ci-clang",
            "configurePreset": "ci-clang"
        }
    ],
    "testPresets": [
        {
            "name": "ci-debug",
            "configurePreset": "ci-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci-release",
            "configurePreset": "ci-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ci-clang",
            "configurePreset": "ci-clang",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "clang-ninja-CI",
            "description": "",
            "displayName": "",
            "configurePreset": "clang-Ninja"
        }
    ]
}